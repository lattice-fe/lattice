DATABASE_URL=postgresql+psycopg://index:index@localhost:5432/index
STORAGE_ROOT=./data/uploads

CHAT_PROVIDER=openai
CHAT_MODEL=auto/best-fast
CHAT_BASE_URL=http://localhost:20128/v1
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Summarization/consolidation pipeline ("understanding").
GROQ_API_KEY=
# Interactive Ask endpoint — separate key/rate-limit budget from the above.
# Falls back to GROQ_API_KEY if unset.
GROQ_API_KEY_CHATS=
# Omniroute proxy (aggregator of free-tier APIs running on localhost:20128)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
